# Modelo das variáveis locais do backend. Copie para backend/.env (fora do git) e
# preencha com os seus valores. Ver "Variáveis de ambiente" no docs/development.md.

# Segredo da assinatura do token JWT: pelo menos 32 caracteres. Sem ele, a aplicação
# não sobe. Use um valor só seu (ex: uma frase longa qualquer).
JWT_SECRET=troque-por-uma-frase-com-pelo-menos-32-caracteres

# Primeiro admin: só é usado quando não existe nenhum ADMIN ativo no banco.
# E-mail válido e senha com pelo menos 8 caracteres.
ADMIN_EMAIL=admin@sublime.com
ADMIN_PASSWORD=troque-esta-senha
