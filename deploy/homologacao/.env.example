# Modelo dos segredos da homologação. Na VPS, copie para .env nesta pasta e troque os valores
# (o .env nunca vai para o git). Gere as senhas e o segredo do JWT com, por exemplo:
#   openssl rand -base64 32

# O endereço do site. Na VPS, o domínio (HTTPS automático); para testar na máquina local,
# http://localhost (sem HTTPS)
SITE_ADDRESS=hom.sublimefisioterapia.com

# O MySQL: a senha do root (só para manutenção) e o usuário da aplicação
MYSQL_ROOT_PASSWORD=troque-esta-senha
MYSQL_USER=sublime
MYSQL_PASSWORD=troque-esta-senha

# O backend: o segredo do token (pelo menos 32 caracteres) e o admin padrão, criado na primeira
# subida (senha com maiúscula, minúscula, número e caractere especial)
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
ADMIN_EMAIL=admin@sublimefisioterapia.com
ADMIN_PASSWORD=Troque-esta-senha1

# As imagens. Vazias: as do registro com a tag dev (ghcr.io/1k2s/sublime-web:dev e
# ghcr.io/1k2s/sublime-backend:dev). Preencha só para subir outra versão
# WEB_IMAGE=
# BACKEND_IMAGE=
